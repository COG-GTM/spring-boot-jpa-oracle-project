{
  "description": "Synthetic HTTP contract scenario for /api/cars. Must start from an empty store with CAR_SEQ / counter at 1.",
  "steps": [
    {"name": "get-all-empty", "method": "GET", "path": "/api/cars"},
    {"name": "create-full", "method": "POST", "path": "/api/cars", "json": {"carBrand": "MAZDA", "carModel": "SKYACTIV-G 2.0", "horsepower": "165", "carEngine": "2000"}},
    {"name": "create-empty-string-and-numeric-hp", "method": "POST", "path": "/api/cars", "json": {"carBrand": "", "carModel": null, "horsepower": 165}},
    {"name": "create-client-id-ignored-unknown-field", "method": "POST", "path": "/api/cars", "json": {"carId": 500, "carBrand": "WITHID", "extra": "x"}},
    {"name": "create-brand-51-chars", "method": "POST", "path": "/api/cars", "json": {"carBrand": "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX1"}},
    {"name": "create-horsepower-7-chars", "method": "POST", "path": "/api/cars", "json": {"horsepower": "1234567"}},
    {"name": "create-brand-50-chars", "method": "POST", "path": "/api/cars", "json": {"carBrand": "YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY"}},
    {"name": "create-multibyte-21-chars", "method": "POST", "path": "/api/cars", "json": {"carBrand": "\u0e42\u0e15\u0e42\u0e22\u0e15\u0e49\u0e32\u0e42\u0e15\u0e42\u0e22\u0e15\u0e49\u0e32\u0e42\u0e15\u0e42\u0e22\u0e15\u0e49\u0e32"}},
    {"name": "create-6-supplementary-chars", "method": "POST", "path": "/api/cars", "json": {"horsepower": "\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00"}},
    {"name": "create-7-supplementary-chars", "method": "POST", "path": "/api/cars", "json": {"horsepower": "\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00\ud83d\ude00"}},
    {"name": "create-whitespace-preserved", "method": "POST", "path": "/api/cars", "json": {"horsepower": "   ", "carEngine": " 2.0 "}},
    {"name": "create-malformed-json", "method": "POST", "path": "/api/cars", "raw": "not json", "contentType": "application/json"},
    {"name": "create-missing-body", "method": "POST", "path": "/api/cars", "raw": "", "contentType": "application/json"},
    {"name": "create-wrong-content-type", "method": "POST", "path": "/api/cars", "raw": "x", "contentType": "text/plain"},
    {"name": "get-all-after-creates", "method": "GET", "path": "/api/cars"},
    {"name": "get-1", "method": "GET", "path": "/api/cars/1"},
    {"name": "get-2-empty-string-became-null", "method": "GET", "path": "/api/cars/2"},
    {"name": "get-missing", "method": "GET", "path": "/api/cars/999"},
    {"name": "get-zero", "method": "GET", "path": "/api/cars/0"},
    {"name": "get-negative", "method": "GET", "path": "/api/cars/-1"},
    {"name": "get-non-numeric", "method": "GET", "path": "/api/cars/abc"},
    {"name": "get-int-overflow", "method": "GET", "path": "/api/cars/2147483648"},
    {"name": "put-existing-partial-body-replaces-all", "method": "PUT", "path": "/api/cars/1", "json": {"carBrand": "TOYOTA"}},
    {"name": "get-1-after-put", "method": "GET", "path": "/api/cars/1"},
    {"name": "put-existing-too-long", "method": "PUT", "path": "/api/cars/1", "json": {"carBrand": "TOYOTA", "carEngine": "1234567"}},
    {"name": "get-1-unchanged-after-failed-put", "method": "GET", "path": "/api/cars/1"},
    {"name": "put-missing-creates-new-id", "method": "PUT", "path": "/api/cars/999", "json": {"carBrand": "PUTNEW"}},
    {"name": "put-zero-creates-new-id", "method": "PUT", "path": "/api/cars/0", "json": {"carBrand": "PUTZERO"}},
    {"name": "put-missing-too-long", "method": "PUT", "path": "/api/cars/998", "json": {"horsepower": "1234567"}},
    {"name": "put-body-id-ignored", "method": "PUT", "path": "/api/cars/3", "json": {"carId": 77, "carBrand": "WITHID-2"}},
    {"name": "delete-missing", "method": "DELETE", "path": "/api/cars/999"},
    {"name": "delete-zero", "method": "DELETE", "path": "/api/cars/0"},
    {"name": "delete-negative", "method": "DELETE", "path": "/api/cars/-5"},
    {"name": "delete-existing", "method": "DELETE", "path": "/api/cars/2"},
    {"name": "get-deleted", "method": "GET", "path": "/api/cars/2"},
    {"name": "delete-already-deleted", "method": "DELETE", "path": "/api/cars/2"},
    {"name": "create-after-gaps", "method": "POST", "path": "/api/cars", "json": {"carBrand": "AFTER"}},
    {"name": "get-all-final", "method": "GET", "path": "/api/cars"}
  ]
}
